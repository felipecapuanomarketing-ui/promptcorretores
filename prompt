<style>
  :root {
    --bg: #000;
    --bg-soft: #0a0a0a;
    --ink: #ffffff;
    --ink-dim: #8a8580;
    --gold: #d4a437;
    --gold-soft: #e6b94a;
    --purple: #8b5cf6;
    --purple-glow: #a78bfa;
    --line: rgba(212, 164, 55, 0.25);
    --card: #0d0d0d;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }
  body {
    background: var(--bg);
    color: var(--ink);
    font-family: 'Manrope', sans-serif;
    line-height: 1.55;
    min-height: 100vh;
    overflow-x: hidden;
    background-image:
      radial-gradient(ellipse at top, rgba(139, 92, 246, 0.08), transparent 50%),
      radial-gradient(ellipse at bottom right, rgba(212, 164, 55, 0.05), transparent 50%);
  }
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    pointer-events: none;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.06'/%3E%3C/svg%3E");
    z-index: 1;
  }
  .container { max-width: 880px; margin: 0 auto; padding: 56px 24px 100px; position: relative; z-index: 2; }
  header { text-align: center; margin-bottom: 64px; padding-bottom: 48px; border-bottom: 1px solid var(--line); }
  .badge {
    display: inline-flex; align-items: center; gap: 8px;
    font-family: 'JetBrains Mono', monospace; font-size: 11px;
    letter-spacing: 0.2em; text-transform: uppercase; color: var(--gold);
    margin-bottom: 28px; padding: 8px 16px;
    border: 1px solid var(--line); border-radius: 100px;
  }
  .badge::before {
    content: ''; width: 6px; height: 6px;
    background: var(--gold); border-radius: 50%;
    box-shadow: 0 0 12px var(--gold);
    animation: pulse 2s ease-in-out infinite;
  }
  @keyframes pulse { 0%,100% { opacity: 1; } 50% { opacity: 0.4; } }
  h1 {
    font-family: 'Anton', sans-serif; font-weight: 400;
    font-size: clamp(48px, 9vw, 88px); line-height: 0.92;
    letter-spacing: 0.01em; text-transform: uppercase;
  }
  h1 .accent {
    color: var(--purple); font-style: italic;
    text-shadow: 0 0 40px rgba(139, 92, 246, 0.4);
  }
  .h1-divider { width: 60px; height: 2px; background: var(--gold); margin: 28px auto; }
  .subtitle { font-size: 16px; color: var(--ink-dim); max-width: 480px; margin: 0 auto; line-height: 1.6; }
  .subtitle strong { color: var(--ink); font-weight: 600; }
  .handle {
    margin-top: 32px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px; letter-spacing: 0.3em; color: var(--ink-dim);
  }
  .instructions {
    background: var(--card); border: 1px solid var(--line);
    padding: 24px 28px; margin-bottom: 72px;
    display: flex; gap: 20px; align-items: flex-start; border-radius: 4px;
  }
  .instructions-icon {
    flex-shrink: 0; width: 40px; height: 40px;
    background: linear-gradient(135deg, var(--gold), var(--gold-soft));
    color: #000; display: grid; place-items: center; border-radius: 50%;
    font-weight: 800; font-family: 'Anton', sans-serif; font-size: 18px;
  }
  .instructions p { font-size: 14px; color: var(--ink-dim); line-height: 1.6; }
  .instructions strong { color: var(--ink); font-weight: 600; }
  .prompt-card { margin-bottom: 64px; position: relative; }
  .prompt-header { margin-bottom: 24px; }
  .prompt-number {
    font-family: 'JetBrains Mono', monospace; font-size: 11px;
    color: var(--gold); letter-spacing: 0.25em;
    margin-bottom: 12px; display: flex; align-items: center; gap: 12px;
  }
  .prompt-number::after {
    content: ''; flex: 1; max-width: 80px; height: 1px;
    background: var(--gold); opacity: 0.5;
  }
  .prompt-title {
    font-family: 'Anton', sans-serif; font-weight: 400;
    font-size: clamp(40px, 7vw, 64px); line-height: 0.95;
    letter-spacing: 0.01em; text-transform: uppercase;
  }
  .prompt-divider { width: 50px; height: 2px; background: var(--gold); margin: 20px 0 0; }
  .prompt-body {
    background: var(--card); border: 1px solid rgba(255,255,255,0.08);
    position: relative; overflow: hidden; margin-top: 24px;
    border-radius: 4px; transition: border-color 0.3s, box-shadow 0.3s;
  }
  .prompt-body:hover { border-color: var(--line); box-shadow: 0 0 30px rgba(212, 164, 55, 0.06); }
  .prompt-body::before {
    content: ''; position: absolute; top: 0; left: 0;
    width: 3px; height: 100%;
    background: linear-gradient(to bottom, var(--gold), transparent);
  }
  .prompt-body pre {
    font-family: 'JetBrains Mono', monospace; font-size: 13px;
    line-height: 1.75; color: var(--ink);
    padding: 28px 28px 88px; white-space: pre-wrap; word-wrap: break-word;
    max-height: 520px; overflow-y: auto;
    scrollbar-width: thin; scrollbar-color: var(--line) transparent;
  }
  .prompt-body pre::-webkit-scrollbar { width: 6px; }
  .prompt-body pre::-webkit-scrollbar-thumb { background: var(--line); border-radius: 3px; }
  .copy-btn {
    position: absolute; bottom: 20px; right: 20px;
    background: linear-gradient(135deg, var(--purple), #6d28d9);
    color: white; border: none; padding: 14px 24px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase;
    cursor: pointer; transition: all 0.25s;
    display: flex; align-items: center; gap: 10px;
    font-weight: 600; border-radius: 100px;
    box-shadow: 0 0 20px rgba(139, 92, 246, 0.3);
  }
  .copy-btn:hover { transform: translateY(-2px); box-shadow: 0 4px 30px rgba(139, 92, 246, 0.5); }
  .copy-btn.copied { background: linear-gradient(135deg, var(--gold), var(--gold-soft)); color: #000; }
  .copy-btn svg { width: 14px; height: 14px; }
  .cta-final {
    margin-top: 100px; padding: 56px 32px;
    background: linear-gradient(135deg, rgba(139, 92, 246, 0.08), rgba(212, 164, 55, 0.04));
    border: 1px solid var(--line); text-align: center;
    border-radius: 4px; position: relative; overflow: hidden;
  }
  .cta-final::before {
    content: ''; position: absolute; top: -50%; left: -50%;
    width: 200%; height: 200%;
    background: radial-gradient(circle, rgba(139, 92, 246, 0.1), transparent 60%);
    animation: rotate 20s linear infinite;
  }
  @keyframes rotate { to { transform: rotate(360deg); } }
  .cta-final > * { position: relative; z-index: 1; }
  .cta-final h2 {
    font-family: 'Anton', sans-serif; font-weight: 400;
    font-size: clamp(32px, 6vw, 56px); line-height: 1;
    text-transform: uppercase; margin-bottom: 20px;
  }
  .cta-final h2 .glow {
    background: linear-gradient(135deg, var(--purple-glow), var(--purple));
    -webkit-background-clip: text; background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .cta-final p { font-size: 16px; color: var(--ink-dim); max-width: 420px; margin: 0 auto 28px; line-height: 1.6; }
  .cta-final p strong { color: var(--ink); font-weight: 600; }
  .cta-instagram {
    display: inline-flex; align-items: center; gap: 12px;
    background: var(--ink); color: #000;
    padding: 16px 32px; border-radius: 100px;
    text-decoration: none; font-weight: 700;
    font-size: 14px; letter-spacing: 0.05em; transition: transform 0.2s;
  }
  .cta-instagram:hover { transform: translateY(-2px); }
  footer { margin-top: 72px; padding-top: 32px; border-top: 1px solid var(--line); text-align: center; }
  footer p {
    font-family: 'JetBrains Mono', monospace; font-size: 10px;
    color: var(--ink-dim); letter-spacing: 0.25em; text-transform: uppercase;
  }
  @media (max-width: 600px) {
    .container { padding: 40px 18px 80px; }
    .prompt-body pre { padding: 22px 22px 84px; font-size: 12.5px; }
    .copy-btn { left: 22px; right: 22px; justify-content: center; }
    .instructions { flex-direction: column; gap: 12px; padding: 20px; }
    .cta-final { padding: 40px 24px; }
  }
</style>
